meta {
  name: 3-GetMe
  type: http
  seq: 3
}

script:pre-request {
  const path = require("path");
  const fs = require("fs");
  const authFile = path.join(process.cwd(), "E2E-UserFlows", "01-Auth-Lifecycle", ".e2e-auth.json");
  if (fs.existsSync(authFile)) {
    const data = JSON.parse(fs.readFileSync(authFile, "utf8"));
    if (data.authToken) bru.setEnvVar("authToken", data.authToken);
    if (data.createdUserId) bru.setEnvVar("createdUserId", data.createdUserId);
  }
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: bearer
  token: {{authToken}}
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder bruger-id der matcher createdUserId", function() {
    const d = res.getBody();
    const expectedId = parseInt(bru.getEnvVar("createdUserId"), 10);
    expect(d).to.have.property("id");
    expect(d.id).to.equal(expectedId);
  });
}
