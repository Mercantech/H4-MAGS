meta {
  name: 5-Logout
  type: http
  seq: 5
}

script:pre-request {
  const path = require("path");
  const fs = require("fs");
  const authFile = path.join(process.cwd(), "E2E-UserFlows", "01-Auth-Lifecycle", ".e2e-auth.json");
  if (fs.existsSync(authFile)) {
    const data = JSON.parse(fs.readFileSync(authFile, "utf8"));
    if (data.authToken) bru.setEnvVar("authToken", data.authToken);
    if (data.refreshToken) bru.setEnvVar("refreshToken", data.refreshToken);
  }
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: json
  auth: bearer
  token: {{authToken}}
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

tests {
  test("Status er 200 eller 204", function() {
    expect(res.getStatus()).to.be.oneOf([200, 204]);
  });
}
