meta {
  name: 2-Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usernameOrEmail": "{{e2eEmail}}",
    "password": "{{e2ePassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const d = typeof res.body === "string" ? JSON.parse(res.body) : (res.body || {});
    const token = d?.token ?? d?.Token;
    const refreshToken = d?.refreshToken ?? d?.RefreshToken;
    if (token) bru.setEnvVar("authToken", String(token));
    if (refreshToken) bru.setEnvVar("refreshToken", String(refreshToken));
    const path = require("path");
    const fs = require("fs");
    const authFile = path.join(process.cwd(), "E2E-UserFlows", "01-Auth-Lifecycle", ".e2e-auth.json");
    try {
      let data = {};
      if (fs.existsSync(authFile)) {
        data = JSON.parse(fs.readFileSync(authFile, "utf8"));
      }
      if (token) data.authToken = String(token);
      if (refreshToken) data.refreshToken = String(refreshToken);
      fs.writeFileSync(authFile, JSON.stringify(data), "utf8");
    } catch (e) {}
  }
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder token", function() {
    expect(res.getBody()).to.have.property("token");
  });
}
