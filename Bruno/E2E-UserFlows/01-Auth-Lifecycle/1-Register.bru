meta {
  name: 1-Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{e2eUsername}}",
    "email": "{{e2eEmail}}",
    "password": "{{e2ePassword}}"
  }
}

script:pre-request {
  const ts = Date.now();
  const r = Math.floor(Math.random() * 10000);
  bru.setEnvVar("e2eUsername", `e2e_${ts}_${r}`);
  bru.setEnvVar("e2eEmail", `e2e_${ts}_${r}@example.com`);
  bru.setEnvVar("e2ePassword", "E2EPassword123!");
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    const d = typeof res.body === "string" ? JSON.parse(res.body) : (res.body || {});
    const user = d?.user ?? d?.User;
    const token = d?.token ?? d?.Token;
    const refreshToken = d?.refreshToken ?? d?.RefreshToken;
    if (user?.id != null) bru.setEnvVar("createdUserId", String(user.id));
    if (token) bru.setEnvVar("authToken", String(token));
    if (refreshToken) bru.setEnvVar("refreshToken", String(refreshToken));
  }
}

tests {
  test("Status er 200 eller 201", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
  test("Response indeholder token og user", function() {
    const d = res.getBody();
    expect(d).to.have.property("token");
    expect(d).to.have.property("user");
    expect(d.user).to.have.property("id");
  });
}
