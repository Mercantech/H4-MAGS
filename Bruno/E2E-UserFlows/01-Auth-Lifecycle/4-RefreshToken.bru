meta {
  name: 4-RefreshToken
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const d = res.body;
    if (d?.token) bru.setEnvVar("authToken", d.token);
    if (d?.refreshToken) bru.setEnvVar("refreshToken", d.refreshToken);
  }
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder nyt token", function() {
    expect(res.getBody()).to.have.property("token");
  });
}
