meta {
  name: 1-Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usernameOrEmail": "{{e2eEmail}}",
    "password": "{{e2ePassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const d = res.body;
    if (d?.token) bru.setEnvVar("authToken", d.token);
    if (d?.refreshToken) bru.setEnvVar("refreshToken", d.refreshToken);
  }
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response indeholder token", function() {
    expect(res.getBody()).to.have.property("token");
  });
}
