meta {
  name: 1-GetWeatherForecast
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/WeatherForecast
  body: none
  auth: none
}

tests {
  test("Status er 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response er array", function() {
    expect(res.getBody()).to.be.an("array");
  });
  test("Indeholder mindst ét element med date og temperatureC", function() {
    const arr = res.getBody();
    expect(arr.length).to.be.at.least(1);
    expect(arr[0]).to.have.property("date");
    expect(arr[0]).to.have.property("temperatureC");
  });
}
